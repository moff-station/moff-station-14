<controls:ChitterUserControl xmlns="https://spacestation14.io"
                             xmlns:controls="clr-namespace:Content.Client._Moffstation.Chitter.ClientUi"
                             Orientation="Horizontal">

    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" HorizontalAlignment="Left" Margin="5">
        <controls:ChitterNoIdentityControl Name="NoIdentity"
                                           Visible="False"
                                           HorizontalExpand="True"
                                           VerticalExpand="True" />
        <controls:ChitterServerConnectionControl Name="Connection"
                                                 Visible="False"
                                                 HorizontalExpand="True"
                                                 VerticalExpand="True" />
    </BoxContainer>
    <TextureButton Name="ConfigurationButton"
                   HorizontalAlignment="Right"
                   TexturePath="/Textures/Interface/VerbIcons/settings.svg.192dpi.png"
                   MaxSize="25 25"
                   Margin="5 0" />
</controls:ChitterUserControl>
