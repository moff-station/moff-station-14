<probe:ChitterProbeView xmlns="https://spacestation14.io"
                        xmlns:probe="clr-namespace:Content.Client._Moffstation.Chitter.Probe"
                        xmlns:logUi="clr-namespace:Content.Client._Moffstation.Chitter.LogUi"
                        xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                        Orientation="Vertical"
                        HorizontalExpand="True"
                        VerticalExpand="True">

    <!-- <PanelContainer StyleClasses="BackgroundDark" /> -->

    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <Label Name="NoScanLabel"
               Text="{Loc 'chitter-probe-no-scan'}"
               ClipText="True"
               Visible="False" />
        <logUi:ChitterLogControl Name="LogControl" Searchable="False" HorizontalExpand="True" VerticalExpand="True" />
        <controls:Separator Orientation="Horizontal" />
        <BoxContainer Name="Footer" Orientation="Horizontal" Margin="10 0 5 0" VerticalAlignment="Bottom">
            <Label Text="{Loc 'chitter-probe-warranty-notice'}" StyleClasses="WindowFooterText" />
            <Label
                Name="Version" Text="v2.0" StyleClasses="WindowFooterText"
                HorizontalAlignment="Right" HorizontalExpand="True" Margin="0 0 5 0" />
            <TextureRect
                StyleClasses="NTLogoDark" Stretch="KeepAspectCentered"
                VerticalAlignment="Center" HorizontalAlignment="Right" SetSize="19 19" />
        </BoxContainer>
    </BoxContainer>
</probe:ChitterProbeView>
