<BoxContainer xmlns="https://spacestation14.io"
              HorizontalExpand="True"
              Orientation="Vertical">

    <BoxContainer Orientation="Horizontal" SetHeight="64" HorizontalAlignment="Center" Margin="0 5">
        <Button Name="SaveButton" StyleClasses="ButtonBig" Margin="10 0" MinSize="120 40"
                Text="{Loc 'humanoid-profile-editor-save-button'}"/>
        <Button Name="ResetButton" StyleClasses="ButtonBig" Margin="10 0" MinSize="120 40"
                Text="{Loc 'humanoid-profile-editor-reset-button'}"/>
    </BoxContainer>

    <RichTextLabel Name="ExplanationLabel" Margin="8 0 8 5"/>

    <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
        <BoxContainer Name="JobList" Orientation="Vertical" />
    </ScrollContainer>
</BoxContainer>
