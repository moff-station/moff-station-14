<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'moff-job-priority-window-title'}"
    MinSize="540 480"
    SetSize="620 620">

    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="6">

        <!-- Explains that these apply to every character, since that is the surprising part -->
        <Label Name="ExplanationLabel"
               Text="{Loc 'moff-job-priority-window-explanation'}"
               Align="Center"
               Margin="0 0 0 6" />

        <!-- One RequirementsSelector per job, grouped by department -->
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Name="JobList" Orientation="Vertical" HorizontalExpand="True" />
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
